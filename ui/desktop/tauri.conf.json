{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoidBlock",
  "version": "0.1.0",
  "identifier": "com.voidblock.desktop",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "dist",
