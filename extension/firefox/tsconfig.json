{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "lib": ["DOM", "ES2021"],
    "outDir": "dist",
    "rootDir": "src",
    "allowJs": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
